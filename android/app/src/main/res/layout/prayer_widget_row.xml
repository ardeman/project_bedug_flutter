<?xml version="1.0" encoding="utf-8"?>
<!-- One upcoming prayer in the tall layouts; rows share the leftover height evenly. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="0dp"
    android:layout_weight="1">
    <FrameLayout android:layout_width="match_parent" android:layout_height="36dp"
        android:layout_gravity="center_vertical">
        <ImageView android:id="@+id/row_highlight" android:layout_width="match_parent"
            android:layout_height="match_parent" android:src="@drawable/prayer_widget_row"
            android:scaleType="fitXY" android:visibility="gone"
            android:importantForAccessibility="no" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
            android:orientation="horizontal" android:gravity="center_vertical"
            android:paddingHorizontal="12dp">
            <TextView android:id="@+id/row_name" android:layout_width="0dp"
                android:layout_weight="1" android:layout_height="wrap_content"
                android:textSize="14sp" android:textColor="@color/widget_text"
                android:maxLines="1" android:ellipsize="end" />
            <TextView android:id="@+id/row_time" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:layout_marginStart="8dp"
                android:textSize="14sp" android:textColor="@color/widget_text"
                android:fontFamily="sans-serif-medium" android:maxLines="1" />
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
