// Cloudflare Workers config for the landing page (site/). The Worker serves
// the static files that `python3 site/build.py` writes to site/dist, and on
// the home pages adds the visitor's approximate location for the live phone
// mock (site/worker.js).
{
  "name": "bedug",
  "main": "site/worker.js",
  "compatibility_date": "2026-10-01",
  // Serve only on bedug.ardeman.com, so the site has one public address,
  // but keep a preview URL for each branch.
  "workers_dev": false,
  "preview_urls": true,
  // Branch builds deploy with `npx wrangler preview`, which needs this block
  // even when empty; previews then inherit the settings above.
  "previews": {},
  "assets": {
    "directory": "./site/dist",
    "binding": "ASSETS",
    // Only the home pages go through the Worker; every other file is served
    // straight from the assets.
    "run_worker_first": ["/", "/en/", "/ar/", "/ms/"],
    "not_found_handling": "404-page"
  }
}
