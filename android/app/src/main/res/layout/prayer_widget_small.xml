<?xml version="1.0" encoding="utf-8"?>
<!-- Two-cell sizes: prayer, time and countdown, with the dial when there is room. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root" android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView android:id="@+id/widget_background"
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:src="@drawable/prayer_widget_background" android:scaleType="fitXY"
        android:importantForAccessibility="no" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="horizontal" android:gravity="center_vertical" android:padding="12dp">
        <LinearLayout android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:orientation="vertical">
            <TextView android:id="@+id/widget_prayer" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:textSize="18sp"
                android:textColor="@color/widget_accent"
                android:maxLines="1" android:ellipsize="end"
                android:autoSizeTextType="uniform" android:autoSizeMinTextSize="12sp"
                android:autoSizeMaxTextSize="18sp" android:autoSizeStepGranularity="1sp" />
            <TextView android:id="@+id/widget_time" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:textSize="12sp"
                android:textColor="@color/widget_text" android:maxLines="1" />
            <Chronometer android:id="@+id/widget_countdown" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:countDown="true"
                android:textSize="20sp" android:textColor="@color/widget_text"
                android:fontFamily="sans-serif-medium" android:maxLines="1" />
            <!-- Unused at this size; kept so every layout has the same views. -->
            <TextView android:id="@+id/widget_title" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:visibility="gone" />
            <TextView android:id="@+id/widget_location" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:visibility="gone" />
        </LinearLayout>
        <ImageView android:id="@+id/widget_dial" android:layout_width="56dp"
            android:layout_height="56dp" android:layout_marginStart="8dp"
            android:visibility="gone" android:importantForAccessibility="no" />
    </LinearLayout>
</FrameLayout>
