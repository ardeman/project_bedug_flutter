{
  "sourceLanguage": "en",
  "strings": {
    "Next prayer": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Salat berikutnya"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Solat seterusnya"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الصلاة التالية"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Next prayer"
          }
        }
      },
      "extractionState": "manual"
    },
    "Counts down to the next prayer, with its time and your city.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hitung mundur ke salat berikutnya, lengkap dengan waktu dan kotamu."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kiraan detik ke solat seterusnya, berserta waktu dan bandar anda."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عدّ تنازلي للصلاة التالية مع وقتها ومدينتك."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Counts down to the next prayer, with its time and your city."
          }
        }
      },
      "extractionState": "manual"
    },
    "Today's prayers": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Salat hari ini"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Solat hari ini"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "صلوات اليوم"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Today's prayers"
          }
        }
      },
      "extractionState": "manual"
    },
    "The whole day at a glance. The next prayer's bar fills as it nears.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sepanjang hari sekali lihat. Bilah salat berikutnya terisi saat waktunya mendekat."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sepanjang hari sekali pandang. Bar solat seterusnya terisi apabila waktunya hampir."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يومك كله في لمحة، ويمتلئ شريط الصلاة التالية كلما اقترب وقتها."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The whole day at a glance. The next prayer's bar fills as it nears."
          }
        }
      },
      "extractionState": "manual"
    },
    "Prayer sky": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Langit salat"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Langit solat"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سماء الصلوات"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Prayer sky"
          }
        }
      },
      "extractionState": "manual"
    },
    "Today's prayers as the sky at each time. The next prayer's bar fills as it nears.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Salat hari ini sebagai langit di tiap waktunya. Bilah salat berikutnya terisi saat waktunya mendekat."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Solat hari ini sebagai langit pada setiap waktunya. Bar solat seterusnya terisi apabila waktunya hampir."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "صلوات اليوم كسماء كل وقت منها، ويمتلئ شريط الصلاة التالية كلما اقترب وقتها."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Today's prayers as the sky at each time. The next prayer's bar fills as it nears."
          }
        }
      },
      "extractionState": "manual"
    },
    "Now": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sekarang"
          }
        },
        "ms": {
