# Cloudflare response headers. The only scripts are the home page's live
# phone mock (assets/live.js and the adhan library it imports), from this
# origin; inline scripts and styles stay blocked.
/*
  Content-Security-Policy: default-src 'none'; script-src 'self'; style-src 'self'; font-src 'self'; img-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), geolocation=(), microphone=(), interest-cohort=()

# The stylesheet name carries a content hash, so it never changes in place.
/assets/style.*
  Cache-Control: public, max-age=31536000, immutable

/assets/fonts/*
  Cache-Control: public, max-age=2592000
