// Cloudflare Workers config for the landing page (site/). The Worker only
// serves the static files that `python3 site/build.py` writes to site/dist.
{
  "name": "bedug",
  "compatibility_date": "2026-10-01",
  // Serve only on bedug.ardeman.com, so the site has one public address,
  // but keep a preview URL for each branch.
  "workers_dev": false,
  "preview_urls": true,
  // Branch builds deploy with `npx wrangler preview`, which needs this block
  // even when empty; previews then inherit the settings above.
  "previews": {},
  "assets": {
    "directory": "./site/dist",
    "not_found_handling": "404-page"
  }
}
