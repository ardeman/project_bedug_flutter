<?xml version="1.0" encoding="utf-8"?>
<!-- The verse of the day; small sizes hide the reason and, except for Arabic, the Arabic. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root" android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView android:id="@+id/widget_background"
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:src="@drawable/prayer_widget_background" android:scaleType="fitXY"
        android:importantForAccessibility="no" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="vertical" android:padding="16dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal">
            <TextView android:id="@+id/widget_title" android:layout_width="0dp"
                android:layout_weight="1" android:layout_height="wrap_content"
                android:text="@string/ayah_widget_title" android:textSize="12sp"
                android:textColor="@color/widget_text" android:maxLines="1"
                android:ellipsize="end" />
            <TextView android:id="@+id/widget_reference" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:layout_marginStart="8dp"
                android:textSize="12sp" android:textColor="@color/widget_text"
                android:alpha="0.7" android:maxLines="1" />
        </LinearLayout>
        <TextView android:id="@+id/widget_why" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="4dp"
            android:textSize="12sp" android:textColor="@color/widget_accent"
            android:maxLines="2" android:ellipsize="end" />
        <TextView android:id="@+id/widget_arabic" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="8dp"
            android:textSize="18sp" android:textColor="@color/widget_text"
            android:textDirection="rtl" android:gravity="end" android:lineSpacingMultiplier="1.2"
            android:ellipsize="end" />
        <TextView android:id="@+id/widget_translation" android:layout_width="match_parent"
            android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="6dp"
            android:textSize="13sp" android:textColor="@color/widget_text"
            android:ellipsize="end" />
    </LinearLayout>
</FrameLayout>
